{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --git-common-dir)/hooks/workflow-policy-guard.py\" hook",
            "timeout": 10,
            "statusMessage": "Checking approved repository policy"
          }
        ]
      }
    ]
  }
}
